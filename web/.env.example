# Copie este arquivo para .env.local e preencha UMA das duas opções.
# As duas ficam em https://www.themoviedb.org/settings/api
# Sem nenhuma delas, o site roda em modo demonstração (dados de exemplo).

# Recomendado: "Token de leitura da API" (o texto longo que começa com eyJ...)
TMDB_API_TOKEN=

# Alternativa: "Chave da API" (32 caracteres)
TMDB_API_KEY=

# ---- Login e dados na nuvem (opcional) ----
# Em https://supabase.com/dashboard › seu projeto › Project Settings › API Keys.
# Sem elas, o site funciona sem login e salva o diário só no navegador.
# Estas duas são públicas por natureza (vão para o navegador); a segurança
# vem das regras RLS de supabase/schema.sql. NUNCA coloque aqui a chave
# "secret" ou "service_role".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Curador, o chat de indicações (opcional) ----
# Qualquer API no formato da OpenAI (/chat/completions) com "tools" funciona.
# Sem estas três, o Curador responde no "modo simples", por palavras-chave.
#
# Google Gemini (tem plano gratuito): chave em https://aistudio.google.com/apikey
#   ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   ASSISTANT_MODEL=gemini-2.5-flash
# Groq (tem plano gratuito):            https://api.groq.com/openai/v1   · llama-3.3-70b-versatile
# Ollama (no seu PC, sem chave):        http://localhost:11434/v1        · qwen2.5:7b
# Claude (pago, por uso):               https://api.anthropic.com/v1     · claude-haiku-4-5
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
